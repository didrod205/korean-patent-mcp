# KIPRIS Plus 서비스 키 (필수)
#
#   발급: https://plus.kipris.or.kr  회원가입 > 서비스 신청 > "특허실용신안 정보검색"
#
#   주의 1: 공공데이터포털(data.go.kr)이 아니라 KIPRIS Plus에서 직접 신청합니다.
#           공공데이터포털의 KIPRISPlus 항목들은 "제공처 바로가기"로 KIPRIS Plus를 가리킬 뿐입니다.
#   주의 2: 다른 KIPRIS 서비스(등록사항·공보·해외특허 등)의 키로는 동작하지 않습니다.
#           이 서버는 patUtiModInfoSearchSevice 하나만 호출합니다.
#   주의 3: 이 서비스가 무료 범위인지 확인하고 신청하세요.
#           KIPRIS Plus Open API에는 유료 구간이 있습니다(수수료 안내 페이지 확인).
#
KIPRIS_SERVICE_KEY=

# 선택: API 베이스 URL 오버라이드 (기본값은 KIPRIS Plus 공식 엔드포인트)
# KIPRIS_BASE_URL=https://plus.kipris.or.kr/kipo-api/kipi

# 선택: 응답 캐시 TTL(초). 기본 3600.
# KIPRIS_CACHE_TTL=3600

# ── 선택: 등록원부 실시간 조회 (연차료·확정 만료일·실제 등록권자) ──
#
# 설정하면 rights_alive의 한계 두 개가 사라집니다:
#   expiry  추정치 → 확정값 (존속기간 연장등록 반영)
#   holder  출원인 → 실제 등록권자
#   annual_fee 필드가 붙습니다
#
# 이건 KIPRIS Plus와 별개 API입니다. 키도 신청도 따로입니다.
#   신청: https://www.data.go.kr/data/15124946/openapi.do
#         "지식재산처_등록원부 실시간 정보 조회 서비스" 활용신청
#         (자동승인, 개발계정 10,000회)
DATA_GO_KR_SERVICE_KEY=

# 오퍼레이션 전체 URL. 활용신청 후 받는 활용가이드 PDF
# ("특허청_등록원부_오픈API활용자가이드_V1.0.pdf")에 적혀 있습니다.
#
# 이 값에 기본값을 넣지 않은 이유: 경로가 웹으로 공개돼 있지 않아 추측해야 하는데,
# 틀린 URL을 기본값으로 박으면 사용자는 키 문제인지 경로 문제인지 구분하지 못합니다.
# 확인 방법:  npx korean-patent-mcp probe --ledger 10-1234567
LEDGER_ENDPOINT=
