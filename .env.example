# KIPRIS Plus 서비스 키 (필수)
#   발급: https://www.data.go.kr/data/15058125/openapi.do  (KIPRISPlus 등록사항 REST API)
#     또는 https://plus.kipris.or.kr  직접 가입
#   data.go.kr에서 받은 "일반 인증키(Decoding)" 값을 그대로 넣습니다.
KIPRIS_SERVICE_KEY=

# 선택: API 베이스 URL 오버라이드 (기본값은 KIPRIS Plus 공식 엔드포인트)
# KIPRIS_BASE_URL=https://plus.kipris.or.kr/kipo-api/kipi

# 선택: 응답 캐시 TTL(초). 기본 3600.
# KIPRIS_CACHE_TTL=3600
